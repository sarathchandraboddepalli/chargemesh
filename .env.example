DATABASE_URL=postgresql+asyncpg://chargemesh:changeme@db:5432/chargemesh
DB_PASSWORD=changeme
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_URL=mqtt://mosquitto:1883

JWT_SECRET_KEY=changeme_generate_a_real_key_min_32_chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

ENCRYPTION_KEY=changeme_fernet_key_must_be_32_bytes

# Maps
MAPBOX_ACCESS_TOKEN=changeme
GOOGLE_MAPS_API_KEY=changeme

# OEM integrations (mock for MVP)
OEM_MODE=mock

# Charging network (mock for MVP)
CHARGING_NETWORK_MODE=mock

# Push notifications (driver app)
FCM_SERVER_KEY=changeme

# Email
EMAIL_BACKEND=console

# OCPP server
OCPP_SERVER_HOST=0.0.0.0
OCPP_SERVER_PORT=9000

FRONTEND_URL=http://localhost:3000
APP_NAME=ChargeMesh
ENVIRONMENT=development
DEBUG=true

# Thermal thresholds (Celsius)
THERMAL_WARNING_THRESHOLD=42
THERMAL_CRITICAL_THRESHOLD=48

# Dispatch config defaults
DISPATCH_SOC_THRESHOLD=25
DISPATCH_SAFETY_BUFFER_KM=10

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
